    "툴바 왼쪽 강의 메뉴에서 새 강의를 추가하거나, 대화 마크다운 파일을 가져올 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novou přednášku přidáte v nabídce přednášek vlevo na panelu nástrojů, nebo importujte soubor Markdown s konverzací."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en ny forelæsning i forelæsningsmenuen til venstre i værktøjslinjen, eller importér en Markdown-fil med en samtale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge im Vorlesungsmenü links in der Symbolleiste eine neue Vorlesung hinzu oder importiere eine Markdown-Datei mit einem Gespräch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόσθεσε νέο μάθημα από το μενού μαθημάτων αριστερά στη γραμμή εργαλείων ή εισήγαγε ένα αρχείο Markdown συζήτησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a new lecture from the lecture menu on the left of the toolbar, or import a conversation Markdown file."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a new lecture from the lecture menu on the left of the toolbar, or import a conversation Markdown file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una clase nueva desde el menú de clases, a la izquierda de la barra de herramientas, o importa un archivo Markdown con una conversación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää uusi luento työkalupalkin vasemmanpuoleisesta luentovalikosta tai tuo keskustelun Markdown-tiedosto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un nouveau cours depuis le menu des cours, à gauche de la barre d’outils, ou importez un fichier Markdown de conversation."
          }
        },
        "id" : {
