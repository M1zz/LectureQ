    "강의를 듣다 떠오른 질문을 가장 쉬운 말로 적어 두세요. 시점은 지금 시각으로 채워져요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강의를 듣다 떠오른 질문을 가장 쉬운 말로 적어 두세요. 시점은 지금 시각으로 채워져요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jot down a question that comes up during a lecture in the simplest words. The time fills in with the current time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jot down a question that comes up during a lecture in the simplest words. The time fills in with the current time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听课时冒出的疑问，用最简单的话记下来。时间会自动填入当前时刻。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上課時冒出的疑問，用最簡單的話記下來。時間點會自動填入目前的時間。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "講義中にふと浮かんだ疑問を、いちばんやさしい言葉で書き留めましょう。時点にはいまの時刻が入ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите вопрос, который пришёл в голову на лекции, самыми простыми словами. Время подставится само."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota con las palabras más sencillas la pregunta que te surja en clase. El momento se rellena con la hora actual."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib eine Frage, die dir in der Vorlesung einfällt, in einfachen Worten auf. Der Zeitpunkt wird mit der aktuellen Uhrzeit ausgefüllt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez en mots simples la question qui vous vient pendant un cours. Le moment se remplit avec l’heure actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi con parole semplici la domanda che ti viene durante una lezione. Il momento si compila con l’ora attuale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote com palavras bem simples a pergunta que surgir durante a aula. O momento é preenchido com a hora atual."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดคำถามที่ผุดขึ้นระหว่างเรียนด้วยคำง่ายๆ เวลาจะถูกใส่เป็นเวลาปัจจุบันให้เอง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy ghi lại câu hỏi nảy ra trong lúc nghe giảng bằng những từ đơn giản nhất. Thời điểm sẽ tự điền giờ hiện tại."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otázku, která vás napadne při přednášce, zapište co nejjednodušeji. Čas se vyplní aktuální dobou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv det spørgsmål, du kommer i tanke om under forelæsningen, med de simpleste ord. Tidspunktet udfyldes med klokkeslættet nu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε με τις πιο απλές λέξεις την ερώτηση που σου έρχεται στο μάθημα. Η χρονική στιγμή συμπληρώνεται με την τρέχουσα ώρα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita luennolla mieleen tullut kysymys mahdollisimman yksinkertaisin sanoin. Ajankohdaksi tulee nykyinen kellonaika."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis pertanyaan yang muncul saat kuliah dengan kata-kata paling sederhana. Waktunya terisi otomatis dengan jam sekarang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv spørsmålet du kommer på under forelesningen med de enkleste ordene. Tidspunktet fylles ut med klokkeslettet nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteer een vraag die tijdens het college bij je opkomt in de eenvoudigste woorden. Het tijdstip wordt ingevuld met de huidige tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz pytanie, które przyszło Ci do głowy na wykładzie, najprostszymi słowami. Czas wypełni się bieżącą godziną."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
