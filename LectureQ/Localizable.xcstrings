    "궁금증을 끝까지 배운 점으로. 연 구독이나 평생 중에 고르세요." : {
      "comment" : "Paywall subtitle",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proměňte každou otázku v něco, co jste se naučili. Vyberte roční předplatné, nebo doživotní nákup."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør hvert spørgsmål til noget, du har lært. Vælg årligt eller livstid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach aus jeder Frage etwas Gelerntes. Wähle jährlich oder lebenslang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε κάθε ερώτηση γνώση. Επιλέξτε ετήσια συνδρομή ή εφ’ όρου ζωής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn every question into something learned. Choose yearly or lifetime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn every question into something learned. Choose yearly or lifetime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte cada duda en algo aprendido. Elige suscripción anual o de por vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta jokainen kysymys opituksi. Valitse vuosittain tai elinikäinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformez chaque question en savoir. Choisissez l’abonnement annuel ou l’achat à vie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubah setiap pertanyaan menjadi hal yang dipelajari. Pilih tahunan atau seumur hidup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasforma ogni domanda in qualcosa di imparato. Scegli l’abbonamento annuale o a vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "疑問を最後まで、学んだことに。年額か買い切りを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "궁금증을 끝까지 배운 점으로. 연 구독이나 평생 중에 고르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør hvert spørsmål til noe du har lært. Velg årlig eller livstid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak van elke vraag iets wat je hebt geleerd. Kies jaarlijks of levenslang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamień każde pytanie w wiedzę. Wybierz subskrypcję roczną lub dożywotnią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transforme cada dúvida em algo aprendido. Escolha a assinatura anual ou vitalícia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превращайте каждый вопрос в знание. Выберите подписку на год или покупку навсегда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör varje fråga till något du har lärt dig. Välj årsvis eller livstid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนทุกข้อสงสัยให้เป็นสิ่งที่ได้เรียนรู้ เลือกแบบรายปีหรือตลอดชีพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her soruyu öğrenilmiş bir şeye dönüştürün. Yıllık veya ömür boyu seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biến mọi thắc mắc thành điều đã học. Chọn gói theo năm hoặc trọn đời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让每个疑问都变成学到的东西。年订阅或永久，任选其一。"
          }
        },
        "zh-Hant" : {
