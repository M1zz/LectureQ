    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: large text layouts",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zvětšení textu se obrazovky přeskupí, místo aby se oříznuly."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gør teksten større, ordnes skærmene om i stedet for at blive skåret af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei größerer Schrift werden Ansichten neu angeordnet, statt abgeschnitten zu werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μεγαλώνεις το κείμενο, οι οθόνες αναδιατάσσονται αντί να κόβονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al agrandar el texto, las pantallas se reorganizan sin cortarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun suurennat tekstiä, näkymät järjestyvät uudelleen eivätkä leikkaudu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous agrandissez le texte, les écrans se réorganisent sans être coupés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat teks diperbesar, tampilan ditata ulang tanpa terpotong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingrandendo il testo, le schermate si riorganizzano senza tagliare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても、切れずに見やすくレイアウトし直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gjør teksten større, ordnes skjermene om i stedet for å bli kuttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij grotere tekst worden schermen opnieuw ingedeeld in plaats van afgekapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po powiększeniu tekstu ekrany układają się na nowo, zamiast się ucinać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o texto, as telas se reorganizam sem cortar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При крупном тексте экраны перестраиваются, ничего не обрезая."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du förstorar texten ordnas skärmarna om i stället för att klippas av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายตัวอักษร หน้าจอจะจัดเรียงใหม่โดยไม่ถูกตัด"
          }
