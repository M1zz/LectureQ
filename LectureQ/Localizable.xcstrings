    "강의 중 생긴 질문을 놓치지 않고, 나중에 내 말로 답하는 노트예요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zápisník, který uchová otázky z přednášek, abyste na ně mohli později odpovědět vlastními slovy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En notesbog, der gemmer de spørgsmål, du får under en forelæsning, så du senere kan besvare dem med dine egne ord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Notizbuch, das die Fragen aus der Vorlesung festhält, damit du sie später mit eigenen Worten beantworten kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα τετράδιο που κρατά τις ερωτήσεις που γεννιούνται στο μάθημα, για να τις απαντήσεις αργότερα με δικά σου λόγια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notebook that keeps the questions you have during a lecture, so you can answer them later in your own words."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notebook that keeps the questions you have during a lecture, so you can answer them later in your own words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
