    "아직 답을 못 찾은 질문을 잊지 않도록 알맞은 때에 알려 줘요." : {
      "comment" : "Roadmap item detail: notifications",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a timely nudge about questions you haven’t answered yet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 답을 못 찾은 질문을 잊지 않도록 알맞은 때에 알려 줘요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a timely nudge about questions you haven’t answered yet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在合适的时候提醒你还没找到答案的问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在適當的時機提醒你還沒找到答案的問題。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ答えが見つかっていない質問を、ちょうどよいタイミングでお知らせします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напомним вовремя о вопросах, на которые вы ещё не нашли ответ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un aviso a tiempo sobre las preguntas que aún no has respondido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte zum passenden Zeitpunkt einen Hinweis auf noch unbeantwortete Fragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soyez prévenu au bon moment des questions restées sans réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi un avviso al momento giusto sulle domande ancora senza risposta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba um aviso na hora certa sobre perguntas que ainda estão sem resposta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งเตือนในเวลาที่เหมาะสมเกี่ยวกับคำถามที่ยังไม่ได้คำตอบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận nhắc nhở đúng lúc về những câu hỏi chưa tìm được câu trả lời."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Včas vás upozorníme na otázky, na které jste ještě nenašli odpověď."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en påmindelse i rette tid om spørgsmål, du endnu ikke har fundet svar på."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έγκαιρη ειδοποίηση για ερωτήσεις που δεν έχεις βρει ακόμη απάντηση."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat oikeaan aikaan muistutuksen kysymyksistä, joihin et ole vielä löytänyt vastausta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan pengingat tepat waktu tentang pertanyaan yang belum terjawab."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en påminnelse til rett tid om spørsmål du ennå ikke har funnet svar på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krijg op het juiste moment een seintje over vragen waar je nog geen antwoord op hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostań przypomnienie we właściwym momencie o pytaniach, na które wciąż nie ma odpowiedzi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
