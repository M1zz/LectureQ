    "문의하실 때 iOS 버전과 어떤 동작에서 문제가 생겼는지 적어 주시면 빠르게 확인할 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když nám píšete, uveďte verzi iOS a co jste dělali, když nastal problém. Pomůže nám to rychleji ho prověřit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du skriver til os, så oplys din iOS-version og hvad du lavede, da problemet opstod – så kan vi hurtigere undersøge det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib uns bei einer Anfrage bitte deine iOS-Version und die Aktion an, bei der das Problem auftrat, dann können wir schneller nachsehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μας γράφεις, ανέφερε την έκδοση iOS και τι έκανες όταν παρουσιάστηκε το πρόβλημα, ώστε να το ελέγξουμε πιο γρήγορα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you write to us, please include your iOS version and what you were doing when the problem happened, so we can look into it quickly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you write to us, please include your iOS version and what you were doing when the problem happened, so we can look into it quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al escribirnos, indica tu versión de iOS y qué estabas haciendo cuando surgió el problema; así podremos revisarlo más rápido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kirjoitat meille, kerro iOS-versiosi ja mitä olit tekemässä, kun ongelma ilmeni. Näin pääsemme selvittämään asiaa nopeammin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous nous écrivez, indiquez votre version de iOS et ce que vous faisiez quand le problème est survenu : nous pourrons vérifier plus vite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat menghubungi kami, sertakan versi iOS dan apa yang sedang kamu lakukan ketika masalah terjadi, supaya kami bisa memeriksanya lebih cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ci scrivi, indica la versione di iOS e cosa stavi facendo quando si è verificato il problema: potremo controllare più in fretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お問い合わせの際は、iOSのバージョンと、どの操作で問題が起きたかを書いていただけると、早く確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문의하실 때 iOS 버전과 어떤 동작에서 문제가 생겼는지 적어 주시면 빠르게 확인할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du skriver til oss, oppgi iOS-versjonen din og hva du holdt på med da problemet oppsto, så kan vi sjekke det raskere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeld in je bericht je iOS-versie en wat je deed toen het probleem optrad, zodat we het sneller kunnen uitzoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisząc do nas, podaj wersję iOS i to, co robiłeś(-aś), gdy wystąpił problem — dzięki temu szybciej to sprawdzimy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao nos escrever, informe a versão do iOS e o que você estava fazendo quando o problema ocorreu, assim conseguimos verificar mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда будете писать нам, укажите версию iOS и что вы делали, когда возникла проблема — так мы разберёмся быстрее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du skriver till oss, ange din iOS-version och vad du gjorde när problemet uppstod, så kan vi undersöka det snabbare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อติดต่อเรา โปรดระบุเวอร์ชัน iOS และสิ่งที่ทำอยู่ตอนเกิดปัญหา เราจะตรวจสอบได้เร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bize yazarken iOS sürümünüzü ve sorun çıktığında ne yaptığınızı belirtin; böylece daha hızlı inceleyebiliriz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi nhắn cho chúng tôi, hãy cho biết phiên bản iOS và thao tác bạn đang làm lúc gặp sự cố để chúng tôi kiểm tra nhanh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来信时，请附上 iOS 版本以及出问题时的操作，我们能更快查明原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來信時，請附上 iOS 版本以及發生問題時的操作，我們就能更快釐清原因。"
          }
        }
      }
    },
    "문의하실 때 macOS 버전과 어떤 동작에서 문제가 생겼는지 적어 주시면 빠르게 확인할 수 있어요." : {
