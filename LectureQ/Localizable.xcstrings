    "Siri에게 앱 이름을 말하지 않아도 지난 질문을 찾아 열고, 새 질문을 바로 적어요." : {
      "comment" : "Roadmap item detail: Siri without saying the app name",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bez názvu aplikace Siri najde a otevře vaše dřívější otázky a hned vám dá zapsat novou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv uden appens navn finder og åbner Siri dine tidligere spørgsmål og lader dig skrive et nyt ned med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch ohne den App-Namen findet und öffnet Siri deine früheren Fragen und lässt dich sofort eine neue notieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμα και χωρίς το όνομα της εφαρμογής, η Siri βρίσκει και ανοίγει τις παλιές σας ερωτήσεις και σας αφήνει να γράψετε αμέσως μια νέα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even without naming the app, Siri finds and opens your past questions and lets you jot down a new one right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even without naming the app, Siri finds and opens your past questions and lets you jot down a new one right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque no digas el nombre de la app, Siri encuentra y abre tus preguntas anteriores y te deja anotar una nueva al momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka et sano sovelluksen nimeä, Siri löytää ja avaa aiemmat kysymyksesi ja antaa kirjata uuden heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même sans nommer l’app, Siri retrouve et ouvre vos questions passées et vous laisse en noter une nouvelle tout de suite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa menyebut nama aplikasi, Siri bisa menemukan dan membuka pertanyaan lama Anda, dan langsung mencatat pertanyaan baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche senza dire il nome dell’app, Siri trova e apre le domande passate e ti fa annotare subito una nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ名を言わなくても、Siriが過去の質問を探して開き、新しい質問もすぐに書き留められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 앱 이름을 말하지 않아도 지난 질문을 찾아 열고, 새 질문을 바로 적어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv uten appnavnet finner og åpner Siri tidligere spørsmål og lar deg skrive ned et nytt med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook zonder de appnaam vindt en opent Siri je eerdere vragen en kun je meteen een nieuwe noteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet bez nazwy aplikacji Siri znajdzie i otworzy Twoje wcześniejsze pytania i od razu pozwoli zapisać nowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo sem dizer o nome do app, a Siri encontra e abre suas perguntas anteriores e deixa você anotar uma nova na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже без названия приложения Siri найдёт и откроет прошлые вопросы и сразу даст записать новый."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även utan appens namn hittar och öppnar Siri dina tidigare frågor och låter dig skriva ner en ny direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องเอ่ยชื่อแอป Siri ก็หาและเปิดคำถามเก่าให้ได้ และจดคำถามใหม่ได้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın adını söylemeseniz de Siri eski sorularınızı bulup açar ve hemen yeni bir soru yazmanızı sağlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần nói tên ứng dụng, Siri vẫn tìm và mở các câu hỏi cũ, và cho bạn ghi ngay câu hỏi mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使不说 App 名称，Siri 也能找到并打开以前的问题，还能马上记下新问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就算不說 App 名稱，Siri 也能找到並打開以前的問題，還能馬上記下新問題。"
          }
        }
      }
    },
