    "강의 중 생긴 질문을 놓치지 않고, 나중에 내 말로 답하는 노트예요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강의 중 생긴 질문을 놓치지 않고, 나중에 내 말로 답하는 노트예요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notebook that keeps the questions you have during a lecture, so you can answer them later in your own words."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notebook that keeps the questions you have during a lecture, so you can answer them later in your own words."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听课时冒出的问题不再溜走，之后再用自己的话作答的笔记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上課時冒出的問題不再溜走，之後再用自己的話作答的筆記。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
