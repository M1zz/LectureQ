    "궁금하면 바로 ⌘⇧N" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napadla vás otázka? Stiskněte ⌘⇧N"
          }
        },
        "da" : {
          "stringUnit" : {
