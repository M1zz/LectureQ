// Version.xcconfig — 질문 노트 (LectureQ)
//
// **버전과 빌드 번호의 단일 소스.** DeployBar 가 배포할 때 이 파일을 고친다 (→ deploy.env 의 VERSION_XCCONFIG).
// project.yml 의 configFiles 로 연결돼 있다.
// ⚠️ project.yml 의 settings.base 에 같은 키를 다시 넣지 말 것 — 프로젝트 설정이 xcconfig 를 이겨 이 파일이 무시된다.
// ⚠️ Mac 앱의 빌드 번호는 앱 전체에서 단조 증가해야 한다.

// 사람이 읽는 버전 (App Store 에 보이는 번호)
MARKETING_VERSION = 1.0.1

// 빌드 번호 — 업로드마다 올린다
CURRENT_PROJECT_VERSION = 8
