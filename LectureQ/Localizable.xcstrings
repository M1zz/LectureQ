    "질문 노트를 열고 지금 보고 있는 강의에 질문을 적는 창을 띄웁니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře Zápisník otázek a zobrazí okno pro zapsání otázky k právě prohlížené přednášce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner Spørgsmålsnoter og viser et vindue, hvor du kan skrive et spørgsmål til den forelæsning, du ser på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet Fragen-Notizen und zeigt ein Fenster, um eine Frage zur aktuellen Vorlesung zu notieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει το Σημειωματάριο Ερωτήσεων και εμφανίζει ένα παράθυρο για να γράψεις μια ερώτηση για το μάθημα που βλέπεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Question Notes and shows a window to write a question for the lecture you're viewing."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Question Notes and shows a window to write a question for the lecture you're viewing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Notas de Preguntas y muestra una ventana para escribir una pregunta de la clase que estás viendo."
