# DeployBar 배포 설정 — 이 파일이 이 앱의 배포 규칙 전부다.
# 참고: DeployBar/README.md 의 "앱 쪽 규칙" 표

# 필수: archive 할 scheme (LectureQ.xcodeproj 는 project.yml 에서 xcodegen 으로 만든다)
SCHEME=LectureQ

# 플랫폼 (ios | macos)
PLATFORM=macos

# 버전·빌드번호의 단일 소스 (project.yml 의 configFiles 로 연결)
VERSION_XCCONFIG=Config/Version.xcconfig

# 배포 전 게이트. 실패하면 아카이브를 만들지 않는다.
PREDEPLOY_SCRIPT=scripts/predeploy.sh

# 다국어: 앱 화면이 한국어 하나라 스토어도 한국어 하나다.
LOCALES=ko,en,en-GB,zh-Hans,zh-Hant,ja,ru,es,de,fr,it,pt-BR,th,vi,cs,da,el,fi,id,nb,nl,pl,sv

# 다국어 게이트 강도 (.xcstrings 가 없어 검사할 것이 없다)
LOCALIZATION_GATE=off

# 릴리즈노트 게이트 — '이 버전의 새로운 기능' 이 비어 있으면 배포 중단.
# 원고는 레포 최상단 RELEASE_NOTES.md 의 `## <버전>` ▸ `### 앱스토어 (...)` 절.
RELEASE_NOTES_GATE=strict
